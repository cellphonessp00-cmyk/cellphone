# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env NUNCA vai para o GitHub (está no .gitignore). Não mande essas chaves para ninguém.

# --- Claude (platform.claude.com -> API Keys) ---
ANTHROPIC_API_KEY=
# Modelo: claude-opus-5-5 (mais inteligente) ou claude-haiku-5-5 (bem mais barato)
CLAUDE_MODELO=claude-opus-5-5
# Esforço de raciocínio: low (mais rápido/barato), medium, high
CLAUDE_ESFORCO=medium

# --- WhatsApp Cloud API (developers.facebook.com -> seu app -> WhatsApp -> Configuração da API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha que VOCÊ inventa e repete na tela de Webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# Configurações do app -> Básico -> Chave secreta do app (confere se as mensagens vieram da Meta)
META_APP_SECRET=
GRAPH_API_VERSAO=v23.0

# --- Lojas e avisos ---
# Quais catálogos o agente atende: cellphones, megacasa ou os dois
LOJAS=cellphones,megacasa
# Seu WhatsApp pessoal (55 + DDD + número) para receber pedidos e pedidos de atendente
DONO_WHATSAPP=
